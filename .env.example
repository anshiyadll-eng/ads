📄 .env.example
# Environment variables for development
BASE_URL=http://localhost:4000
NODE_ENV=development
PORT=4000
CORS_ORIGINS=*
SOCKET_CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
JWT_SECRET=super-secret-key

GMAIL_USER=myemail@gmail.com
GMAIL_APP_PASSWORD=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=10000

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=5
OTP_MAX_ATTEMPTS=20

SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_DAYS=30

APP_NAME=AG Chat
SUPPORT_EMAIL=support@agchat.example.com